{
  "name": "dr-hooks",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n registry,next -c blue,green \"yarn registry --watch\" \"next dev\"",
    "build": "yarn registry && next build",
    "start": "next start",
    "lint": "eslint .",
    "registry": "tsx --tsconfig ./tsconfig.scripts.json ./src/scripts/registry.mts",
    "typecheck": "tsc --noEmit",
    "new": "tsx --tsconfig ./tsconfig.scripts.json ./src/scripts/new.mts",
    "prepare": "husky install",
    "test": "vitest",
    "postinstall": "yarn registry"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@shikijs/transformers": "4.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^0.542.0",
    "motion": "^12.23.24",
    "next": "^16.1.1",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.3.1",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.1.4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "gray-matter": "^4.0.3",
    "husky": "^8.0.0",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rimraf": "^6.0.1",
    "shadcn": "^2.9.3-canary.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5",
    "typescript-eslint": "^8.53.1",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
